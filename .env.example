# GlowSync AI - Environment Configuration
# Copy this file to .env or .env.local to connect your live backend or Firebase instance

# Node.js / Flask AI Deep Learning API Endpoint
# Default: Falls back to built-in demonstration pipeline if not reachable
VITE_API_BASE_URL=http://localhost:5000/api

# Optional: Firebase Authentication & Cloud Firestore (if configured)
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
